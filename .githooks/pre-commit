#!/usr/bin/env sh
set -eu

fail() {
  echo "[Shinhan QnA hook] $1" >&2
  exit 1
}

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
case "$branch" in
  main) fail "main 브랜치에는 직접 커밋할 수 없습니다." ;;
esac

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged_files" ] && exit 0

if printf '%s\n' "$staged_files" | grep -Eq '(^|/)(\.env|\.env\..*|.*\.(pem|key|p12|jks|keystore))$'; then
  fail "환경변수 또는 키 파일은 커밋할 수 없습니다."
fi

git diff --cached --check || fail "공백 오류가 포함되어 있습니다."

git diff --cached --unified=0 --no-color | awk '/^\+[^+]/ { print substr($0, 2) }' | ./scripts/check-sensitive-data.sh || fail "커밋할 변경에서 민감정보 형식이 발견되었습니다."

if git diff --cached --unified=0 --no-color | grep -E '^\+[^+]' | grep -Eq -- '-----BEGIN [A-Z ]*PRIVATE KEY-----'; then
  fail "커밋할 변경에서 개인 키 형식이 발견되었습니다."
fi

if git diff --cached --unified=0 --no-color | grep -E '^\+[^+]' | grep -Eq '^\+<<<<<<<|^\+=======|^\+>>>>>>>'; then
  fail "충돌 마커를 제거한 뒤 커밋하세요."
fi

git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -n1 sh -c '
  path="$1"
  size=$(git cat-file -s ":$path" 2>/dev/null || echo 0)
  if [ "$size" -gt 10485760 ]; then
    echo "[Shinhan QnA hook] 10MB 초과 파일: $path" >&2
    exit 1
  fi
' sh || exit 1

case "$(printf '%s\n' "$staged_files")" in
  *app/src/*|*app/build.gradle.kts*|*gradle/*.toml*|*gradle.properties*)
    ./gradlew :app:testDebugUnitTest || fail "Android 단위 테스트가 실패했습니다."
    ;;
esac
